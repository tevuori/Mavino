# ===== Mavino Student OS — environment variables =====
# Copy to .env and fill in. The real .env is gitignored.

# --- Server ---
SERVER_PORT=3001
SERVER_HOST=0.0.0.0
# PostgreSQL connection string. For local dev, run a Postgres instance:
#   docker run -d --name mavino-pg -e POSTGRES_DB=athena -e POSTGRES_USER=athena -e POSTGRES_PASSWORD=athena -p 5432:5432 postgres:16-alpine
# Then run: cd server && bunx prisma migrate dev && bun run src/db/seed.ts
DATABASE_URL="postgresql://athena:CHANGE_ME@localhost:5432/athena?schema=public"
# PostgreSQL credentials for Docker Compose (used by the db service + backup script).
# Generate a strong password: openssl rand -hex 24
POSTGRES_DB=athena
POSTGRES_USER=athena
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_RANDOM_PASSWORD
# Redis for shared rate limiting across multiple server instances.
# When set, the rate limiter uses Redis INCR+EXPIRE. When unset, falls back
# to in-memory (single-container only). Docker Compose sets this automatically.
# REDIS_URL=redis://localhost:6379
# SMTP for transactional emails (password reset, subscription renewal
# reminders, etc.). When unset, emails are logged to the server console
# instead of sent. Use any SMTP provider:
#   Gmail:     smtps://user:app-password@smtp.gmail.com:465
#   SendGrid:  smtp://apikey:SG.xxx@smtp.sendgrid.net:587
#   Mailgun:   smtp://postmaster@domain:password@smtp.mailgun.org:587
#   Seznam:    smtps://user%40domain.com:password@smtp.seznam.cz:465
# Note: URL-encode special chars in the username (@ → %40) and password
# (# → %23, % → %25, > → %3E, etc.).
# SMTP_URL=
# SMTP_FROM=Mavino <noreply@yourdomain.com>
# The public base URL for links in emails (e.g. https://mavino.example.com).
# If unset, falls back to SERVER_HOST:SERVER_PORT.
# APP_BASE_URL=
# Cloudflare Turnstile bot protection (optional but recommended for public deploys).
# Get keys at https://dash.cloudflare.com/?to=/:account/turnstile.
# When both keys are set, login and registration require a Turnstile challenge.
# When unset, bot protection is skipped (development mode).
# TURNSTILE_SITE_KEY=0x4AAAAAAA...
# TURNSTILE_SECRET_KEY=0x4AAAAAAA...
# IMPORTANT: set a long random string (>= 32 chars) for any non-local deploy.
# The server refuses to start in production if this is missing or < 32 chars.
# Generate one with:  openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
# ENCRYPTION_KEY — separate secret for AES-256-GCM encryption of stored
# credentials (VUT passwords, LLM/ElevenLabs/Spotify/MS API keys, OAuth tokens,
# TOTP secrets). Should be DIFFERENT from JWT_SECRET (key separation).
# Generate one with:  openssl rand -hex 32
# If unset, falls back to JWT_SECRET (with a warning in production) for
# backward compatibility. Existing deployments with encrypted data: set this
# to your current JWT_SECRET value to avoid re-encrypting, or leave unset.
ENCRYPTION_KEY=
# Default seed admin (created on first run if no users exist).
# In production: if SEED_PASSWORD is unset or "admin", a strong random password
# is generated and printed once to the console. The user is FORCED to change it
# on first login. In dev: defaults to "admin" (still forced to change).
SEED_USERNAME=admin
SEED_PASSWORD=
# Comma-separated list of allowed CORS origins for the public deploy.
# When set, only these origins may call the API. Leave empty for local dev
# (reflects the request origin). For the VPS deploy:
#   CLIENT_ORIGIN=https://mavino.net
CLIENT_ORIGIN=

# --- Client (Vite) ---
VITE_API_URL=http://localhost:3001

# --- Spotify ---
# Server-wide fallback: used when a user has no per-user Spotify credentials.
# Each user can configure their own Spotify credentials in Settings → Integrations.
# Get these from https://developer.spotify.com/dashboard.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# A long-lived refresh token (obtained once via the auth code PKCE flow).
SPOTIFY_REFRESH_TOKEN=
# Redirect URI registered in your Spotify app (must match).
SPOTIFY_REDIRECT_URI=http://localhost:5173/auth/spotify/callback

# --- LRCLIB ---
# Already public API; no key needed. We set a descriptive User-Agent server-side.

# --- LLM (AI Study Assistant — deferred, placeholder) ---
# LLM_PROVIDER=ollama|openai|anthropic
# LLM_API_KEY=
# LLM_BASE_URL=http://localhost:11434

# --- Mavino assistant (multi-llm-ts) ---
# Server-wide fallback used when a user has no per-user AI config in the DB.
# Per-user config (apiKey + provider + baseUrl + modelId) is stored encrypted
# in the DB (Settings → Mavino Assistant) and takes priority. Any multi-llm-ts
# provider id works: openai | deepseek | anthropic | openrouter | ollama | groq
# | mistralai | google | xai | meta | cerebras.
# If neither per-user nor server-wide keys are set, Mavino AI is unavailable.
# OPENAI_PROVIDER=openai
# OPENAI_BASE_URL=
# OPENAI_API_KEY=
# OPENAI_MODEL=
# Whisper model for Voice Notes + Lecture Video transcription
# (OpenAI-compatible /audio/transcriptions endpoint).
# OPENAI_TRANSCRIPTION_MODEL=whisper-1
#
# IMPORTANT for Lecture Video → Notes: many OpenAI-compatible providers
# (OpenCode Zen, OpenRouter, Ollama) do NOT serve /audio/transcriptions.
# Set these to point to a real OpenAI key or any Whisper-compatible endpoint:
# OPENAI_TRANSCRIPTION_BASE_URL=https://api.openai.com/v1
# OPENAI_TRANSCRIPTION_API_KEY=sk-...
# If unset, falls back to the user's LLM config (which may not support Whisper).

# --- ElevenLabs TTS (Interactive Teacher voice) ---
# Server-wide fallback: used when a user has no per-user TtsCredential.
# Each user can configure their own ElevenLabs key in Settings → Mavino Assistant.
# Without a key, the Teach Me mode falls back to the browser Web Speech API.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM  # Rachel (default)

# --- Microsoft (Calendar sync) ---
# Server-wide fallback: used when a user has no per-user Microsoft credentials.
# Each user can configure their own MS credentials in Settings → Integrations.
# Azure AD app — https://portal.azure.com/#view/Microsoft_AAD_RegisteredApps
# Requires Calendar.ReadWrite + offline_access scopes. The refresh token is
# obtained once via the OAuth2 auth-code flow; Microsoft may rotate it on
# refresh — the server persists the latest token in the DB automatically.
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=common
MS_REFRESH_TOKEN=
# Redirect URI registered in your Azure app (Authentication → Web → Redirect URI).
# The server exposes a public callback at this path. In production, ensure your
# reverse proxy routes this path to the server (not the client SPA).
# Default: https://mavino.net/auth/callback
MS_REDIRECT_URI=https://mavino.net/auth/callback

# --- Mavino code execution sandbox (run_code tool) ---
# The sandbox runs Python/JS/TS snippets in a throwaway Docker container.
# Requires the `docker` CLI on the host (or the Docker socket mounted into
# the server container — see docker-compose.yml). Auto-disabled when docker
# is not found. Set to "false" to explicitly disable.
# SANDBOX_ENABLED=true
# SANDBOX_TIMEOUT_MS=10000
# SANDBOX_MAX_CODE_CHARS=20000
# SANDBOX_PYTHON_IMAGE=python:3.12-slim
# SANDBOX_NODE_IMAGE=node:22-slim
# Docker runtime for sandbox containers. Use "runsc" (gVisor) on public
# deployments for kernel-level isolation — prevents container escape.
# Install gVisor first: https://gvisor.dev/docs/user_guide/install/
# SANDBOX_DOCKER_RUNTIME=runsc

# --- Mavino web tools ---
# Web search backend priority: Tavily → Brave → DuckDuckGo.
# Tavily (https://tavily.com) is designed for AI agents — free tier: 1,000 API
# credits/month, no credit card. Get a key at https://app.tavily.com.
# Also works in keyless mode (rate-limited, no registration) when no key is set.
# TAVILY_API_KEY=
# Brave Search API — secondary backend (free tier discontinued).
# BRAVE_SEARCH_API_KEY=
# Without any key, falls back to the free DuckDuckGo HTML scraper, which
# requires no API key but is often blocked by an anti-bot challenge on
# datacenter/VPS IPs (the tool will return a clear error in that case).
# For any public deploy, set TAVILY_API_KEY (or BRAVE_SEARCH_API_KEY).
# URL fetching (fetch_url, create_notes_from_url) uses @postlight/parser
# for Readability extraction — no API key required.

# --- Ntfy (push notifications + bidirectional Mavino channel) ---
# Server-wide fallback used when a user has no per-user Ntfy config in the DB.
# Per-user config (server URL + token + topics) is stored encrypted in the DB
# (Settings → Integrations or the Ntfy app) and takes priority.
# NTFY_SERVER_URL=https://ntfy.sh
# NTFY_TOKEN=
# NTFY_DEFAULT_PRIORITY=3

