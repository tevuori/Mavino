generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @default("") // optional — used for password reset
  passwordHash String
  displayName  String   @default("")
  avatarColor  String   @default("#6366f1")
  role         String   @default("FREE") // "ADMIN" | "PAID" | "MANAGER" | "FREE" | "DEMO"
  athenaInstructions String @default("") // custom instructions injected into Athena system prompt
  // 2FA (TOTP) — totpSecret stores the base32-encoded secret (encrypted at
  // rest via services/crypto.ts). totpEnabled is false until the user
  // completes the verification step (scans QR, enters a valid code).
  totpSecret   String   @default("")
  totpEnabled  Boolean  @default(false)
  // Set to true when the password is a generated/seed default that the user
  // must change on first login. Cleared by the password-change / reset endpoints.
  passwordMustChange Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  notes       Note[]
  noteFolders NoteFolder[]
  tasks       Task[]
  files       VFile[]
  folders     VFolder[]
  settings    Setting[]
  lyricsCache LyricsCache[]
  flashcardDecks FlashcardDeck[]
  courses     Course[]
  vutCreds    VutCredentials?
  aiCred      AiCredential?
  workspaces  Workspace[]
  taskWorkspaces TaskWorkspace[]
  studySessions StudySession[]
  calendarEvents CalendarEvent[]
  habits      Habit[]
  chatConversations ChatConversation[]
  whiteboards Whiteboard[]
  ntfyConfig    NtfyConfig?
  ntfyCronJobs  NtfyCronJob[]
  ntfyMessages  NtfyMessage[]
  proactiveAlertConfig ProactiveAlertConfig?
  memories      AthenaMemory[]
  itemLinks     ItemLink[]
  refreshTokens RefreshToken[]
  spotifyCredential  SpotifyCredential?
  microsoftCredential MicrosoftCredential?
  studySources  StudySource[]
  conceptGraphs ConceptGraph[]
  studyChats    StudyChat[]
  podcasts      Podcast[]
  studyWorkspaces LearningWorkspace[]
  teacherSessions TeacherSession[]
  ttsCredential   TtsCredential?
  reminders       Reminder[]
  lectureJobs     LectureJob[]
  focusSessions   FocusSession[]
  flashcardReviews FlashcardReview[]
  gamificationState GamificationState?
  studyHighlights   StudyHighlight[]
  moodleSyncs       MoodleSync[]
  mapyCredentials   MapyCredentials?
  trips             Trip[]
  hikingTours       HikingTour[]
  passwordResetTokens PasswordResetToken[]
  errorLogs          ErrorLog[]
}

// ===== Password reset tokens =====
// Self-service password reset: a user requests a reset link by email, a
// token is generated and stored (SHA-256 hashed, like refresh tokens), and
// emailed. The user clicks the link, enters a new password, and the token
// is consumed. Tokens expire after 1 hour and are single-use.

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique // SHA-256 of the raw token
  expiresAt DateTime
  usedAt    DateTime? // null until consumed
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ===== Study Hub: persistent user highlights & annotations =====
// A user-created highlight on a Study Hub reading surface (AI output, cited
// chat answer, or source document). Anchored by text snippet + before/after
// context (re-located via search on render) and scoped to a contentKey (hash
// of the rendered content) so highlights reappear when the same content is
// shown again. The central "Highlights" Study Hub mode lists all of them and
// can export a selection to a Note.

model StudyHighlight {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Where the highlight was made: "chat" | "teacher" | "summarize" | "explain"
  // | "study_guide" | "podcast" | "note" | "editor"
  scope         String
  // Id of the containing entity (chatId, sessionId, noteId, fileId, ...) or
  // a synthetic key for transient AI outputs.
  scopeId       String
  // Fast hash of the rendered content — highlights are re-anchored only when
  // the same content is rendered again.
  contentKey    String
  // The highlighted passage.
  text          String
  // Up to ~80 chars of surrounding text for disambiguation on re-anchor.
  contextBefore String   @default("")
  contextAfter  String   @default("")
  // One of: yellow | green | blue | pink | purple
  color         String   @default("yellow")
  // Optional user annotation / note attached to the highlight.
  annotation    String?
  // Optional human label for the source content (shown in the Highlights list).
  sourceName    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([userId, scope, scopeId])
  @@index([userId, contentKey])
}

// ===== Refresh tokens (device-remembering) =====
// Long-lived session tokens bound to a browser fingerprint. Issued on login
// when "Remember this device" is checked. The raw token is sent to the client;
// only its SHA-256 hash is stored. Rotated on each use. Revocable per-device
// from Settings → Account.

model RefreshToken {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash          String   @unique // SHA-256 hex of the raw refresh token
  deviceFingerprint  String   // browser fingerprint hash at issue time
  deviceLabel        String   @default("") // human label derived from User-Agent
  expiresAt          DateTime
  lastUsedAt         DateTime @default(now())
  createdAt          DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ===== Proactive Alerts (Athena daily briefing scheduler) =====
// One row per user. When enabled, the proactive scheduler fires an Athena
// LLM turn at the configured hour:minute each day, gathers context via tools
// (calendar, tasks, habits, + due flashcards in the system prompt), and pushes
// a concise briefing to the user's ntfy notify topic.

model ProactiveAlertConfig {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  enabled     Boolean  @default(false)
  hour        Int      @default(8)      // 0-23, server-local time
  minute      Int      @default(0)      // 0-59
  categories  String   @default("calendar,tasks,flashcards,habits") // comma-separated
  customPrompt String  @default("")     // optional override of the briefing prompt
  lastRunAt   DateTime?
  nextRunAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([enabled, nextRunAt])
}

// ===== Generic symmetric item links (drag-to-link between apps) =====
// Polymorphic relation between any two workspace items (note, task,
// flashcardDeck, calendarEvent, file). Symmetric: querying an item unions
// both src and dst rows. src/dst are canonicalized on write (lexicographic
// by type then id) so the unique constraint prevents A-B / B-A duplicates.
// No DB-level FK to the referenced entities (polymorphic); orphan rows are
// cleaned up via cleanupOrphanLinks() in the respective delete routes.

model ItemLink {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  srcType   String   // "note" | "task" | "flashcardDeck" | "calendarEvent" | "file"
  srcId     String
  dstType   String
  dstId     String
  createdAt DateTime @default(now())

  @@unique([userId, srcType, srcId, dstType, dstId])
  @@index([userId, srcType, srcId])
  @@index([userId, dstType, dstId])
}

// ===== Athena persistent memory =====
// Key facts/preferences the user asks Athena to remember, recalled in future
// turns via the system prompt (recent 5) or the recall_memory tool.

model AthenaMemory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  category  String   @default("general") // general|preference|fact|goal|person
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, category])
  @@index([userId, updatedAt])
}

// ===== Reminders (one-shot, ntfy-delivered) =====
// A one-shot reminder that fires at `fireAt` and pushes a notification to the
// user's ntfy notify topic. Two types:
//   - "basic": pushes the fixed `message` body at fireAt (no LLM).
//   - "athena": runs `prompt` through an Athena LLM turn at fireAt (so the
//     reminder can gather context — calendar, tasks, exam details — and be
//     tailored at fire time), then pushes the generated reply.
// Distinct from NtfyCronJob (which is recurring cron). A fired reminder is
// kept (fired=true) for history; it never refires.

model Reminder {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String    @default("basic") // "basic" (no LLM) | "athena" (LLM at fire time)
  title     String    @default("")
  // type="basic": the fixed message body pushed at fireAt.
  message   String    @default("")
  // type="athena": the prompt run through the LLM at fireAt; the reply is pushed.
  prompt    String    @default("")
  fireAt    DateTime
  priority  Int       @default(3) // 1-5
  tags      String    @default("")
  fired     Boolean   @default(false)
  firedAt   DateTime?
  cancelled Boolean   @default(false)
  createdAt DateTime  @default(now())

  @@index([userId, fired, cancelled, fireAt])
  @@index([userId])
}

// ===== Ntfy (bidirectional Athena communication channel + cron) =====

model NtfyConfig {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  serverUrl String   @default("https://ntfy.sh")
  tokenEnc  String   @default("") // AES-256-GCM encrypted bearer token (optional)
  notifyTopic String // Athena → user (user subscribes to this on their phone)
  inboxTopic  String // user → Athena (server subscribes to this)
  enabled   Boolean  @default(true)
  defaultPriority Int @default(3) // 1-5
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NtfyCronJob {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  cron      String   // 5-field cron expression (e.g. "0 8 * * *")
  type      String   @default("notification") // "notification" | "athena"
  // For type="notification": the fixed message body sent at each fire.
  message   String   @default("")
  // For type="athena": the prompt run through the LLM at each fire; the
  // generated reply is published to the notify topic.
  prompt    String   @default("")
  title     String   @default("")
  priority  Int      @default(3) // 1-5
  tags      String   @default("")
  enabled   Boolean  @default(true)
  lastRunAt DateTime?
  nextRunAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, enabled, nextRunAt])
  @@index([userId])
}

model NtfyMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  direction String   @default("out") // "in" | "out" | "cron"
  topic     String   @default("")
  title     String   @default("")
  body      String   @default("")
  priority  Int      @default(3)
  tags      String   @default("")
  cronJobId String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// ===== Whiteboard (vector drawing canvas) =====

model Whiteboard {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String   @default("Untitled")
  content   String   @default("[]") // JSON array of vector elements
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, updatedAt])
}

model ChatConversation {
  id        String   @id @default(cuid())
  title     String   @default("New Chat")
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    String   @default("active") // "active" | "archived"
  messages  Json     @default("[]") // array of { role, content, tools?, timestamp }
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastMessageAt DateTime @default(now())

  @@index([userId, status])
  @@index([userId, updatedAt])
}

model NoteFolder {
  id       String @id @default(cuid())
  name     String
  parentId String?
  parent   NoteFolder? @relation("NoteFolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children NoteFolder[] @relation("NoteFolderTree")
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes    Note[]
  position Int    @default(0)

  @@index([userId, parentId])
}

model Note {
  id        String   @id @default(cuid())
  title     String   @default("Untitled")
  content   String   @default("")
  tags      String   @default("") // comma-separated
  folderId  String?
  folder    NoteFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  podcasts  Podcast[]

  @@index([userId, folderId])
  @@index([userId, updatedAt])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

model TaskWorkspace {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  color     String   @default("#6366f1")
  tasks     Task[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId])
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String       @default("")
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  recurring   String       @default("") // e.g. "daily", "weekly"
  order       Int          @default(0)
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String?
  workspace   TaskWorkspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([userId, status])
  @@index([userId, workspaceId])
}

model VFolder {
  id       String   @id @default(cuid())
  name     String
  parentId String?
  parent   VFolder? @relation("VFolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children VFolder[] @relation("VFolderTree")
  files    VFile[]   @relation("VFolderFiles")
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, parentId])
}

model VFile {
  id         String   @id @default(cuid())
  name       String
  mimeType   String   @default("application/octet-stream")
  size       Int      @default(0)
  storageKey String   // relative path under uploads/ (empty for external/virtual files)
  // When set, the file's content is streamed from this external URL on demand
  // (e.g. a Moodle resource) instead of being read from uploads/. Used together
  // with `source` to mark the file as managed by an integration.
  externalUrl String?
  // Origin of the file: "manual" (user upload/text), "moodle" (synced virtual file).
  source     String   @default("manual")
  // Integration-specific reference id (e.g. Moodle activity id) for dedupe/sync.
  sourceRef  String   @default("")
  folderId   String?
  folder     VFolder? @relation("VFolderFiles", fields: [folderId], references: [id], onDelete: SetNull)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  starred    Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  lastOpenedAt DateTime?

  @@index([userId, folderId])
  @@index([userId, starred])
  @@index([userId, lastOpenedAt])
  @@index([userId, source, sourceRef])
}

model LyricsCache {
  id            String   @id @default(cuid())
  trackId       String   // Spotify track URI or id
  trackName     String
  artistName    String
  albumName     String   @default("")
  duration      Int      @default(0)
  syncedLyrics  String   @default("") // LRC text
  plainLyrics   String   @default("")
  instrumental  Boolean  @default(false)
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fetchedAt     DateTime @default(now())

  @@unique([trackId])
  @@index([trackName, artistName])
}

model Setting {
  id     String @id @default(cuid())
  key    String
  value  String
  userId String?
  user   User?  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

// ===== Flashcards (Spaced Repetition / SM-2) =====

model FlashcardDeck {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  color       String   @default("#6366f1")
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cards       Flashcard[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model Flashcard {
  id          String   @id @default(cuid())
  deckId      String
  deck        FlashcardDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)
  front       String
  back        String
  // Optional reference to the StudySource / note / file a card was generated from
  // (used to render a "from: <source>" chip on the card). Free-form label, not an FK.
  sourceRef   String   @default("")
  // SM-2 algorithm fields
  easeFactor  Float    @default(2.5)
  interval    Int      @default(0)  // days
  repetitions Int      @default(0)
  dueDate     DateTime @default(now())
  lastReviewed DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([deckId])
  @@index([dueDate])
}

// ===== Grade Tracker / GPA Calculator =====

model Course {
  id          String   @id @default(cuid())
  name        String
  code        String   @default("")  // e.g. "CS 101"
  semester    String   @default("")  // e.g. "Fall 2025"
  credits     Int      @default(3)
  color       String   @default("#6366f1")
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments Assignment[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, semester])
}

model Assignment {
  id         String  @id @default(cuid())
  courseId   String
  course     Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  name       String
  score      Float   // e.g. 92.5
  maxScore   Float   @default(100)
  weight     Float   @default(1) // multiplier for weighted average
  category   String  @default("General") // e.g. "Homework", "Exam", "Quiz"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([courseId])
}

// ===== VUT Integration =====

model VutCredentials {
  id        String  @id @default(cuid())
  userId    String  @unique
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  username  String  // VUT login (e.g. xlogin00)
  passwordEnc String // AES-256-GCM encrypted
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ===== AI provider credentials (OpenCode Zen / OpenAI-compatible) =====

model AiCredential {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiKeyEnc  String   // AES-256-GCM encrypted API key
  provider   String   @default("openai") // multi-llm-ts engine id (openai|deepseek|anthropic|openrouter|ollama|...)
  baseUrl    String?  // optional custom base URL (e.g. OpenCode Zen: https://opencode.ai/zen/v1)
  modelId    String?  // optional model id override

  // Rate limit protection (for free-tier models like OpenRouter :free)
  rateLimitEnabled  Boolean @default(false)
  rateLimitRpd      Int     @default(50)  // requests per day (OpenRouter free: 50 without $10 credits)
  rateLimitRpm      Int     @default(20)  // requests per minute (OpenRouter free: 20)

  // Fallback LLM — used when the primary model hits rate limits
  fallbackApiKeyEnc String?  // encrypted fallback API key
  fallbackProvider  String?  // fallback provider engine id
  fallbackBaseUrl   String?  // fallback base URL
  fallbackModelId   String?  // fallback model id

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ===== Spotify credentials (per-user) =====
// Each user connects their own Spotify account. All fields encrypted.
// Server-wide SPOTIFY_* env vars serve as an optional fallback.

model SpotifyCredential {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientIdEnc     String   // AES-256-GCM encrypted
  clientSecretEnc String   // AES-256-GCM encrypted
  refreshTokenEnc String   // AES-256-GCM encrypted
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ===== Microsoft Calendar credentials (per-user) =====
// Each user connects their own Outlook calendar via Graph API.
// The refresh token may rotate on each exchange — the latest is persisted
// back here. Server-wide MS_* env vars serve as an optional fallback.

model MicrosoftCredential {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientIdEnc     String   // AES-256-GCM encrypted
  clientSecretEnc String   // AES-256-GCM encrypted
  tenantId        String   @default("common")
  refreshTokenEnc String   // AES-256-GCM encrypted (rotated in-place)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ===== Athena Workspaces (saved window layouts) =====

model Workspace {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  layout    String   // JSON: array of { appId, title, rect, payload }
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
}

// ===== AI Study Hub (activity log for study workflows) =====

model StudySession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // "flashcards" | "summary" | "quiz" | "explain" | "study_guide" | "syllabus"
  title     String
  sourceRef String   @default("") // note id / file id / "paste"
  meta      String   @default("") // JSON: card count, score, etc.
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// ===== Calendar / Planner =====

model CalendarEvent {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String   @default("")
  start       DateTime
  end         DateTime
  allDay      Boolean  @default(false)
  color       String   @default("#6366f1")
  location    String   @default("")
  source      String   @default("manual") // manual|task|vut|assignment|ics
  sourceRef   String   @default("")       // taskId / ics uid / etc.
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, start])
}

// ===== Habit Tracker =====

model Habit {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  icon         String   @default("✅")
  color        String   @default("#6366f1")
  cadence      String   @default("daily") // daily|weekly
  target       Int      @default(1)
  linkedApp    String?  // pomodoro|flashcards|null
  linkedMetric String?  // focusSessions|focusMinutes|reviews
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  logs         HabitLog[]

  @@index([userId])
}

model HabitLog {
  id        String   @id @default(cuid())
  habitId   String
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  userId    String
  date      String   // YYYY-MM-DD
  value     Int      @default(1)
  createdAt DateTime @default(now())

  @@unique([habitId, date])
  @@index([userId, date])
}

// ===== Study Hub: NotebookLM-style sources / chats / podcasts =====

// A persistent study source: a note, file (incl. PDF), pasted text, Moodle
// resource, or web URL that has been resolved to plain text and cached so it
// can be reused across grounded Q&A, podcasts, and cited study materials
// without re-extracting on every use.
model StudySource {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  // "note" | "file" | "paste" | "moodle" | "url"
  kind      String
  // Note/file id, "paste", or the URL (for moodle/url). Free-form, not an FK.
  refId     String   @default("")
  // Truncated extracted plain text (capped at MAX_SOURCE_CHARS). Re-extractable
  // via the /refresh endpoint when the underlying note/file changes.
  textCache String   @default("")
  truncated Boolean  @default(false)
  charCount Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, kind])
}

// ===== Concept graph (knowledge graph) =====
// A structured representation of a fixed set of StudySources — concepts,
// their definitions/facts, and typed relationships between them, each
// citing the source(s) it was drawn from. Built once per unique source-set
// via a single LLM extraction pass (services/study/graph.ts) and then
// reused to derive flashcards, quizzes, summaries, explanations, and study
// guides without re-analyzing the raw source text every time.
model ConceptGraph {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  // Sorted JSON array of StudySource ids this graph was built from.
  sourceIds String   @default("[]")
  // Sorted, comma-joined StudySource ids — dedupe/lookup key (one graph per
  // unique source-set per user).
  sourceKey String   @default("")
  // JSON-encoded ConceptGraphData: { summary, sources, concepts, relationships }.
  data      String   @default("{}")
  status    String   @default("ready") // "building" | "ready" | "error"
  error     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, sourceKey])
}

// A persisted source-grounded Q&A conversation (NotebookLM "notebook").
// Scoped to a fixed set of StudySources whose text is injected into the
// system prompt as numbered SOURCE blocks for inline [n] citations.
model StudyChat {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @default("New Study Chat")
  // JSON array of StudySource ids this chat is grounded on.
  sourceIds String   @default("[]")
  // JSON array of { role: "user"|"assistant", content: string, citations?: [{index,name,refId,kind}], timestamp: string }
  messages  String   @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastMessageAt DateTime @default(now())

  @@index([userId])
  @@index([userId, updatedAt])
}

// An audio overview / "podcast" generated from one or more StudySources.
// The LLM writes a 2-host dialogue script (saved as a Note); audio is played
// back in-browser via the Web Speech API (see client usePodcastTts). The
// script note is the persistent, downloadable artifact.
model Podcast {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  // The saved dialogue script note.
  scriptNoteId String?
  scriptNote Note?  @relation(fields: [scriptNoteId], references: [id], onDelete: SetNull)
  // JSON array of StudySource ids this podcast was generated from.
  sourceIds String   @default("[]")
  host1Label String  @default("Host A")
  host2Label String  @default("Host B")
  // Rough duration estimate in seconds (derived from script length).
  durationEstimate Int @default(0)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, createdAt])
}

// A named, persistent group of StudySources — a "learning workspace" / notebook.
// The student builds the source set once and reuses it to start grounded chats
// or podcasts without re-picking sources each time. One workspace can back
// many StudyChats and Podcasts.
model LearningWorkspace {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  color       String?  // optional accent color (hex)
  // JSON array of StudySource ids included in this workspace.
  sourceIds   String   @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([userId, updatedAt])
}

// ===== TTS credentials (per-user, for Interactive Teacher voice) =====
// ElevenLabs is the primary provider (character-level timestamps for
// speech-synced highlighting). Server-wide ELEVENLABS_API_KEY env var is the
// fallback. If neither is set, the client falls back to Web Speech API.
model TtsCredential {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiKeyEnc  String   // AES-256-GCM encrypted ElevenLabs API key
  voiceId    String?  // optional voice id override
  modelId    String?  // optional model id (e.g. "eleven_turbo_v2")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ===== Interactive Teacher ("Teach Me" mode) sessions =====
// A persisted live-tutoring session: source-grounded, with an ordered
// source-history (which sources were shown, in what order, what was
// highlighted), a comprehension log, and the chat messages. Reuses the
// StudySource cache for grounding and the [n] citation convention. Resumable
// from the Study Hub Recent Activity list.
model TeacherSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @default("Teach Me session")
  // JSON array of StudySource ids this session is grounded on.
  sourceIds String   @default("[]")
  // JSON array of { role: "user"|"assistant", content: string, tools?: [], timestamp: string }.
  messages  String   @default("[]")
  // JSON: { studentLevel, sourceHistory: [{ windowId, index, name, kind, refId, lastHighlight }], coveredConcepts: [], comprehensionLog: [] }
  state     String   @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastMessageAt DateTime @default(now())

  @@index([userId])
  @@index([userId, updatedAt])
}

// ===== Anonymous usage analytics (admin-only) =====
// Per-feature, per-day hit counts. NO userId is ever stored — only an
// aggregate counter incremented by the analytics middleware on each API
// request. Used by the admin Analytics view in Settings to show which
// features are used most. The in-memory buffer in services/analytics.ts
// is flushed here every 30s to avoid a DB write per request.

model UsageStat {
  id      String   @id @default(cuid())
  feature String   // "notes" | "tasks" | "athena" | ...
  day     DateTime // UTC midnight bucket
  count   Int      @default(0)

  @@unique([feature, day])
  @@index([day])
}

// ===== Lecture Video → Notes pipeline =====
// Tracks the progress of a long-running lecture-processing job: upload → ffmpeg
// audio extraction → Whisper transcription → slide dedup → per-slide LLM notes.
// The client polls for status updates while the pipeline runs in the background.

model LectureJob {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Source video file (VFile id). Not an FK — orphan cleanup handled in delete route.
  videoFileId String

  // Pipeline config chosen by the user at start.
  style      String   @default("outline")  // "cornell" | "outline" | "summary" | "bullets"
  detail     String   @default("standard") // "brief" | "standard" | "detailed"
  language   String   @default("en")       // "en" | "cs"
  videoType  String   @default("slides")   // "slides" (screen capture) | "camera" (professor filmed)

  // Pipeline progress.
  status     String   @default("queued")   // "queued" | "processing" | "completed" | "failed"
  stage      String   @default("")         // current stage label for UI: "audio_extract" | "transcribing" | "frame_sampling" | "slide_dedup" | "region_detect" | "ocr" | "generating_notes" | ""
  progress   Int      @default(0)          // 0–100 percentage
  error      String   @default("")         // error message if status="failed"

  // Output references (set when completed).
  noteId     String?  // the generated Note id
  folderId   String?  // VFolder id where slide images were saved
  slideCount Int      @default(0)
  durationSec Int     @default(0)          // detected video duration in seconds

  // Meta (JSON blob for extra info: transcript word count, etc.)
  meta       String   @default("{}")

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([userId, status])
}

// ===== Gamification & Study Analytics =====

// A completed Pomodoro focus session. Logged by the Pomodoro app on each
// completed focus phase (natural completion or skip) so the Analytics
// dashboard can chart study hours over time. The Pomodoro app still writes
// today's aggregate stats to localStorage for habit auto-completion; this
// table provides the historical record.

model FocusSession {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date            String   // YYYY-MM-DD (local-day bucket)
  durationMinutes Int      // actual focus minutes logged
  phase           String   @default("focus") // "focus" (breaks are not logged)
  createdAt       DateTime @default(now())

  @@index([userId, date])
  @@index([userId, createdAt])
}

// A single flashcard review event. Written alongside the SM-2 card update in
// the review endpoint so the Analytics dashboard can chart reviews/day and a
// retention curve (recall success rate = quality >= 3 over time). Without
// this log, only the latest review per card would be recoverable.

model FlashcardReview {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardId    String
  deckId    String
  quality   Int      // 0-5 (SM-2 quality)
  date      String   // YYYY-MM-DD
  createdAt DateTime @default(now())

  @@index([userId, date])
  @@index([userId, cardId])
  @@index([deckId])
}

// Per-user gamification state. Only the set of unlocked achievement ids is
// persisted (so newly-unlocked achievements can be detected and toasted).
// XP and level are derived from the dated event logs (FocusSession,
// FlashcardReview, HabitLog, Task, StudySession) by the /api/analytics/me
// endpoint, so no XP ledger is needed.

model GamificationState {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  unlockedAchievements String   @default("[]") // JSON array of achievement ids
  updatedAt            DateTime @updatedAt
}

// ===== Moodle integration: per-course sync state =====
// Tracks which Moodle courses have been synced into Tasks/Calendar/Files so the
// Moodle app can show sync status and re-syncs can dedupe (upsert by courseId).

model MoodleSync {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId        String
  courseName      String   @default("")
  lastSyncAt      DateTime @default(now())
  assignmentCount Int      @default(0)
  materialCount   Int      @default(0)

  @@unique([userId, courseId])
  @@index([userId])
}

// ===== Mapy.cz integration: per-user API key =====
// The user's own mapy.com developer API key (AES-256-GCM encrypted in DB),
// configured in Settings → Integrations. Used for the REST API (geocoding,
// routing, POI search, elevation) and the Leaflet raster tiles in the Maps app.
// Note: mapy.com terms require the API key belong to the app developer's
// Project; for a personal/single-user deploy the user is the developer.

model MapyCredentials {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiKeyEnc  String   // AES-256-GCM encrypted
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ===== Saved trips (hiking / bicycle / car) =====
// A planned trip: route geometry, waypoints, points of interest (water sources,
// legal sleeping spots, landmarks) discovered along the route, and a summary.

model Trip {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  type        String   // "hiking" | "bicycle" | "car"
  distanceM   Float    // total distance in meters
  durationS   Int      // estimated duration in seconds
  ascentM     Float    @default(0)  // total ascent (hiking)
  descentM    Float    @default(0)  // total descent (hiking)
  geometry    String   // JSON: array of [lat, lon] route points
  waypoints   String   @default("[]") // JSON: [{ name, lat, lon, type? }]
  pois        String   @default("[]") // JSON: [{ name, lat, lon, category, description? }]
  summary     String   @default("")  // human-readable plan / notes
  // Optional: links this Trip to a day of a multi-day HikingTour.
  tourId      String?  // null = standalone trip
  dayNumber   Int?     // 1-based day index within the tour (null = standalone)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([tourId])
}

// ===== Multi-day hiking tours (advanced planner) =====
// A multi-day hiking tour generated by the advanced planner. Each day is a
// separate Trip row linked via tourId + dayNumber. Two modes:
//   - "hub":     loop hikes from a single base (accommodation) — directions
//                spread evenly around the compass so loops don't overlap.
//   - "through": point-to-point chain, with overnight stops auto-found near
//                each day's endpoint (mountain huts / shelters).
// The summary holds the LLM-narrated day-by-day plan.

model HikingTour {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  mode          String   // "hub" | "through"
  baseLat       Float
  baseLon       Float
  baseName      String
  endLat        Float?   // through-mode end point (null for hub)
  endLon        Float?
  endName       String?
  numDays       Int
  difficulty    String   // "easy" | "medium" | "hard" | "expert"
  totalDistanceM Float   @default(0)
  totalAscentM  Float    @default(0)
  totalDurationS Int     @default(0)
  summary       String   @default("") // LLM-narrated day-by-day plan
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

// ===== Error logs (admin monitoring) =====

model ErrorLog {
  id        String   @id @default(cuid())
  timestamp DateTime @default(now())
  level     String   @default("error") // "error" | "warn" | "fatal"
  source    String   @default("server") // "client" | "server"
  message   String
  stack     String?  @db.Text
  url       String?
  userAgent String?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([timestamp])
  @@index([resolved])
  @@index([source])
}
