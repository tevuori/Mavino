{
  "name": "mavino-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "bun src/db/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.4.3",
    "@postlight/parser": "^2.2.3",
    "@prisma/client": "^6.19.3",
    "@types/nodemailer": "^8.0.1",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.2.0",
    "croner": "^10.0.1",
    "edge-tts-universal": "^1.4.0",
    "fflate": "^0.8.3",
    "file-type": "^22.0.1",
    "hono": "^4.13.2",
    "ioredis": "^6.0.0",
    "jose": "^5.10.0",
    "multi-llm-ts": "5.0.1",
    "nodemailer": "^9.0.5",
    "otplib": "^12.0.1",
    "pdf-parse": "^2.4.5",
    "qrcode": "^1.5.4",
    "stripe": "^22.5.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/bun": "^1.3.14",
    "prisma": "^6.19.3",
    "typescript": "^5.9.3"
  },
  "patchedDependencies": {
    "multi-llm-ts@5.0.1": "patches/multi-llm-ts@5.0.1.patch"
  },
  "overrides": {
    "form-data": "^2.5.4",
    "brace-expansion": "^5.0.8",
    "nth-check": "^2.0.1",
    "qs": "^6.14.1",
    "tough-cookie": "^4.1.3",
    "undici": "^7.29.0"
  }
