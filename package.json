{
  "name": "mavino-student-os",
  "version": "0.1.0",
  "private": true,
  "description": "A desktop-environment-style productivity dashboard for students.",
  "scripts": {
    "dev:server": "cd server && bun run dev",
    "dev:client": "cd client && bun run dev",
    "dev": "concurrently -n server,client -c blue,magenta \"bun run dev:server\" \"bun run dev:client\"",
    "build:client": "cd client && bun run build",
    "build:server": "cd server && bun run build",
    "build": "bun run build:server && bun run build:client",
    "typecheck:server": "cd server && bun run typecheck",
    "typecheck:client": "cd client && bun run typecheck",
    "typecheck": "bun run typecheck:server && bun run typecheck:client",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "db:generate": "cd server && bunx prisma generate",
    "db:migrate": "cd server && bunx prisma migrate dev",
    "db:seed": "cd server && bun run src/db/seed.ts",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "install:all": "bun install && cd server && bun install && cd ../client && bun install",
    "cap:sync": "VITE_CAPACITOR_BUILD=true bun run build:client && bunx cap sync",
    "cap:add:android": "bunx cap add android",
    "cap:add:ios": "bunx cap add ios",
    "cap:open:android": "bunx cap open android",
    "cap:open:ios": "bunx cap open ios",
    "waydroid:deploy": "./scripts/waydroid-deploy.sh",
    "waydroid:deploy:fast": "./scripts/waydroid-deploy.sh --skip-build"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@capacitor/cli": "^8.4.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.56.1",
    "concurrently": "^9.1.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.66.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.4.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3"
  }
}
